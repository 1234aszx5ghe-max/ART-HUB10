-- HOVER ปุ่ม
--==================================================

local originalSize = button.Size
local originalPosition = button.Position

button.MouseEnter:Connect(function()
	TweenService:Create(button, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(1, -36, 0, 52),
		Position = UDim2.new(0, 18, 0, 149)
	}):Play()
	TweenService:Create(buttonStroke, TweenInfo.new(0.18), {
		Transparency = 0.45
	}):Play()
end)

button.MouseLeave:Connect(function()
	TweenService:Create(button, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = originalSize,
		Position = originalPosition
	}):Play()
	TweenService:Create(buttonStroke, TweenInfo.new(0.18), {
		Transparency = 0.75
	}):Play()
end)

--==================================================
-- กดปุ่มคัดลอก
--==================================================

button.MouseButton1Click:Connect(function()
	-- เอฟเฟกต์กด
	TweenService:Create(button, TweenInfo.new(0.08), {
		Size = UDim2.new(1, -44, 0, 48)
	}):Play()
	task.wait(0.08)
	TweenService:Create(button, TweenInfo.new(0.12), {
		Size = originalSize
	}):Play()

	-- คัดลอก
	setclipboard(SCRIPT_LINK)

	buttonText.Text = "คัดลอกแล้ว!"
	TweenService:Create(button, TweenInfo.new(0.2), {
		BackgroundColor3 = COPIED_COLOR
	}):Play()

	task.wait(1.6)

	buttonText.Text = "คัดลอกลิงก์สคริปต์"
	TweenService:Create(button, TweenInfo.new(0.2), {
		BackgroundColor3 = ACCENT
	}):Play()
end)

